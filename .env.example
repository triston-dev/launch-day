# Copy this file to .env and fill in what you need. Everything is optional.

# Lets "Sign in through Steam" read your library so owned games are marked,
# the same way SteamDB does. Free at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# PORT=4310
# HOST=127.0.0.1
# REFRESH_HOURS=6
# STORE_COUNTRY=US
# PUBLIC_URL=https://calendar.example.com
